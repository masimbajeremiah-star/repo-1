# Browser on the same Mac:
VITE_SOCKET_URL=http://localhost:3000

# Physical phone QA: replace with the Mac's current LAN address before building.
# VITE_SOCKET_URL=http://192.168.x.x:3000

VITE_ADMIN_VIEW=false
VITE_SHOW_DEBUG_CONTROLS=false
VITE_ENABLE_PLUS=true
VITE_ENABLE_COSMETICS=true
VITE_ENABLE_ADS=true
VITE_ENABLE_CREATORS=true
VITE_ENABLE_CLUBS=true
